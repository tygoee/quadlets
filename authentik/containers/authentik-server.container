[Unit]
Description=Authentik server container
BindsTo=authentik-postgres.container authentik-worker.container
After=authentik-postgres.container authentik-worker.container

[Container]
ContainerName=authentik-server
Image=ghcr.io/goauthentik/server:2026.5.5
Exec=server
AutoUpdate=registry
Volume=authentik-data:/data:idmap,z
PublishPort=9000:9000
#PublishPort=9443:9443
Network=authentik.network
UserNS=auto
EnvironmentFile=/etc/containers/environment/authentik.env

[Service]
Restart=unless-stopped

[Install]
WantedBy=default.target
